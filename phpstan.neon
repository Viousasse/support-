includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/xefi/phpstan-xefi-rules/extension.neon

parameters:
    level: 7

    parseModelCastsMethod: true

    paths:
        - app
        - database
        - layers/tickets/database
        - layers/tickets/src
        - routes

    excludePaths:
        analyse:
            # Published as-is by spatie/laravel-permission.
            - database/migrations/*_create_permission_tables.php

    databaseMigrationsPath:
        - database/migrations
        - layers/tickets/database/migrations

    stubFiles:
        - phpstan/faker-mixin.stub.php

    ignoreErrors:
        # controlled() is a query builder macro registered by lomkit/laravel-access-control.
        -
            identifier: method.notFound
            message: '#::controlled\(\)#'
        # TP6 requires catching the business exception in the Livewire layer to turn it
        # into a user message. This is the only place where NoTryCatchRule is waived.
        -
            identifier: xefi.noTryCatch
            path: app/Livewire/Tickets/TicketForm.php
